# Lokal: cp .env.example .env  va to'ldiring.
# Vercel: Project → Settings → Environment Variables ga xuddi shu nomlar bilan kiriting.

# ── Baza ─────────────────────────────────────────────
# Neon → Dashboard → Connect → "Pooled connection"
DATABASE_URL=postgresql://USER:PAROL@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Kirish ───────────────────────────────────────────
# Brauzerdan kirish paroli (Telegram ichida parol so'ralmaydi)
APP_PASSWORD=
# Uzun tasodifiy satr:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Telegram ─────────────────────────────────────────
# @BotFather → /newbot dan olingan token
TELEGRAM_BOT_TOKEN=
# Sizning Telegram ID'ingiz (raqam). Bilmasangiz — @userinfobot ga /start yozing
TELEGRAM_OWNER_ID=
# Webhook himoyasi uchun tasodifiy satr (faqat harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=
# Kunlik eslatma (cron) himoyasi uchun tasodifiy satr — Vercel uni o'zi yuboradi
CRON_SECRET=

# ── Ixtiyoriy ────────────────────────────────────────
# Vaqt mintaqasi (standart: Asia/Tashkent)
# APP_TZ=Asia/Tashkent
# Sayt manzili (odatda avtomatik aniqlanadi)
# APP_URL=https://moliya.vercel.app

# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring.

# Kirish paroli. Bo'sh qoldirilsa — parolsiz ochiladi (faqat o'z kompyuteringizda shunday qiling!)
APP_PASSWORD=

# Cookie uchun maxfiy kalit — istalgan uzun tasodifiy satr.
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# SQLite baza fayli yo'li. Serverda doimiy saqlanadigan diskka (volume) ko'rsating,
# masalan Railway'da: /data/moliya.db   (bo'sh bo'lsa: ./data/moliya.db)
DATABASE_PATH=

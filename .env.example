# Lokal: cp .env.example .env  va to'ldiring.
# Vercel: Project → Settings → Environment Variables ga xuddi shu nomlar bilan kiriting.

# ── Baza ─────────────────────────────────────────────
# Neon → Dashboard → Connect → "Pooled connection"
DATABASE_URL=postgresql://USER:PAROL@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Telegram ─────────────────────────────────────────
# @BotFather → /newbot dan olingan token. Bo'sh bo'lsa — lokal rejim (login yo'q, bitta foydalanuvchi)
TELEGRAM_BOT_TOKEN=
# Bot username (@ siz). Bo'sh bo'lsa Telegram'dan avtomatik olinadi
TELEGRAM_BOT_USERNAME=
# Webhook himoyasi va /api/telegram/setup?key=... uchun tasodifiy satr (harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=

# ── Xavfsizlik ───────────────────────────────────────
# Sessiya imzosi uchun uzun tasodifiy satr (MAJBURIY). O'zgartirilsa — hamma qaytadan kiradi.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Kunlik eslatma (cron) himoyasi — Vercel uni o'zi yuboradi
CRON_SECRET=

# ── Ixtiyoriy ────────────────────────────────────────
# Faqat shu Telegram ID'lar kira oladi (vergul bilan). Bo'sh = hamma kira oladi
# ALLOWED_USER_IDS=123456789,987654321
# Eski (bir kishilik) versiyadagi ma'lumotlarni shu ID egasiga biriktirish
# TELEGRAM_OWNER_ID=123456789
# Vaqt mintaqasi (standart: Asia/Tashkent)
# APP_TZ=Asia/Tashkent
# Sayt manzili (odatda avtomatik aniqlanadi)
# APP_URL=https://moliya.vercel.app

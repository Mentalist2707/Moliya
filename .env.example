# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring.
# Vercel'da esa: Project → Settings → Environment Variables ga kiriting.

# Neon baza ulanish manzili (Neon → Dashboard → Connect → "Pooled connection")
DATABASE_URL=postgresql://USER:PAROL@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Kirish paroli. Bo'sh qoldirilsa — parolsiz ochiladi (internetda albatta qo'ying!)
APP_PASSWORD=

# Cookie uchun maxfiy kalit — istalgan uzun tasodifiy satr.
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
